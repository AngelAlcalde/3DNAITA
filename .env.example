# GEMINI_API_KEY: Optional Gemini API key if AI assistance features are enabled.
GEMINI_API_KEY=""

# SUPABASE CONFIGURATION (Base de datos PostgreSQL en la nube y Realtime)
# Obtén estas credenciales desde tu panel de Supabase: Project Settings -> API
# En Vercel, agrega estas dos variables en Project Settings -> Environment Variables:
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-anon-publica-aqui"

# APP_URL: URL donde está alojada la aplicación (ej: https://3dna.vercel.app)
APP_URL="http://localhost:3000"

# Suprimir advertencia de configuración nativa en Vite
VITE_CONFIG_NATIVE_IGNORE_WARNING="true"
